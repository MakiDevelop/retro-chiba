---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { localizedPath } from '../i18n/utils';

interface Props {
  entry: CollectionEntry<'exhibitions'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { data } = entry;
const sixthGenShowcase =
  data.slug === 'sixth-gen-war'
    ? [
        { title: 'Dreamcast', slug: 'dreamcast', src: '/img/consoles/thumbs/dreamcast-hero-640.webp' },
        { title: 'PlayStation 2', slug: 'ps2', src: '/img/consoles/thumbs/ps2-hero-640.webp' },
        { title: 'GameCube', slug: 'gamecube', src: '/img/consoles/thumbs/gamecube-hero-640.webp' },
        { title: 'Xbox', slug: 'xbox', src: '/img/consoles/thumbs/xbox-hero-640.webp' },
      ]
    : [];
---

<main class="exhibition">
  <header class="exhibition-header">
    <div class="eyebrow">{data.eyebrow}</div>
    <h1>{data.title}</h1>
    {data.description && <p class="lead">{data.description}</p>}
  </header>

  {
    sixthGenShowcase.length > 0 && (
      <section class="showcase-grid" aria-label="Sixth generation console lineup">
        {sixthGenShowcase.map((console) => (
          <a href={localizedPath(data.lang, `/consoles/${console.slug}/`)} class="showcase-card">
            <img src={console.src} alt="" loading="eager" decoding="async" />
            <div>
              <h2>{console.title}</h2>
              <p>VIEW CONSOLE</p>
            </div>
          </a>
        ))}
      </section>
    )
  }

  <article class="exhibition-body">
    <Content />
  </article>
</main>

<style>
  .exhibition {
    max-width: 860px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }
  .exhibition-header {
    margin-bottom: 3rem;
    text-align: center;
  }
  .eyebrow {
    font-size: 0.9rem;
    letter-spacing: 2px;
    opacity: 0.6;
    margin-bottom: 0.5rem;
  }
  .lead {
    font-size: 1.15rem;
    line-height: 1.6;
    max-width: 720px;
    margin: 1rem auto 0;
    opacity: 0.85;
  }
  .showcase-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    margin: 0 0 3rem;
  }
  .showcase-card {
    display: block;
    overflow: hidden;
    border: 1px solid rgba(77, 255, 136, 0.45);
    background: rgba(18, 24, 28, 0.35);
    color: inherit;
    text-decoration: none;
    transition:
      background-color 160ms ease,
      border-color 160ms ease,
      filter 160ms ease;
  }
  .showcase-card:hover {
    border-color: rgba(250, 179, 60, 0.65);
    background: rgba(18, 24, 28, 0.6);
  }
  .showcase-card img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-bottom: 1px solid rgba(77, 255, 136, 0.35);
    transition: filter 160ms ease;
  }
  .showcase-card:hover img {
    filter: brightness(1.1);
  }
  .showcase-card div {
    padding: 1rem;
  }
  .showcase-card h2 {
    margin: 0;
    color: rgb(250, 179, 60);
    font-family: 'Press Start 2P', monospace;
    font-size: 0.65rem;
    line-height: 1.5;
  }
  .showcase-card p {
    margin: 0.75rem 0 0;
    color: rgba(233, 220, 190, 0.7);
    font-size: 0.85rem;
    line-height: 1.5;
  }
  .exhibition-body {
    font-size: 1.05rem;
    line-height: 1.75;
  }
  .exhibition-body :global(h2) {
    margin-top: 3rem;
    margin-bottom: 1rem;
    font-size: 1.6rem;
  }
  @media (max-width: 860px) {
    .showcase-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .showcase-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
