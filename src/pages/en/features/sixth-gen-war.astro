---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SpecialExhibition from '../../../components/SpecialExhibition.astro';

const entry = (await getCollection('exhibitions')).find((item) => item.data.slug === 'sixth-gen-war' && item.data.lang === 'en');

if (!entry) {
  throw new Error('Missing sixth-gen-war en exhibition content');
}
---

<BaseLayout title={entry.data.title} description={entry.data.description} type="article" canonicalPath="/en/features/sixth-gen-war/">
  <SpecialExhibition entry={entry} />
</BaseLayout>
