---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SpecialExhibition from '../../components/SpecialExhibition.astro';

const entry = (await getCollection('exhibitions')).find((item) => item.data.slug === 'sixth-gen-war' && item.data.lang === 'zh-tw');

if (!entry) {
  throw new Error('Missing sixth-gen-war zh-tw exhibition content');
}
---

<BaseLayout title={entry.data.title} description={entry.data.description} image={entry.data.hero?.src} type="article" canonicalPath="/features/sixth-gen-war/">
  <SpecialExhibition entry={entry} />
</BaseLayout>
